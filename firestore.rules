rules_version = '2';

// Solo-user tool: anonymous auth (enabled in the Firebase console under
// Authentication -> Sign-in method) is enough to keep this off the open
// internet without a login screen. Anyone signed in, even anonymously,
// can read/write everything, since there's only ever one user.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
